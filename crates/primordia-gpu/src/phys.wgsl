// Physics phases 2-5 and 7-9 (everything except the interpreter), ported
// line by line from primordia-core/src/phases.rs. State stays resident on
// the GPU; the constant block is generated by primordia-core::wgsl.

@group(0) @binding(0) var<storage, read_write> tapes: array<u32>;
@group(0) @binding(1) var<storage, read_write> hdr: array<u32>;
@group(0) @binding(2) var<storage, read_write> fields: array<u32>;
@group(0) @binding(3) var<storage, read_write> site: array<u32>;
@group(0) @binding(4) var<storage, read> nbr: array<u32>;
@group(0) @binding(5) var<storage, read> Q: array<u32>;
@group(0) @binding(6) var<storage, read> TB: array<u32>;
@group(0) @binding(7) var<storage, read_write> light: array<u32>;
@group(0) @binding(8) var<storage, read> rows: array<u32>;
@group(0) @binding(9) var<storage, read> vents: array<u32>;
@group(0) @binding(10) var<storage, read> mmap: array<u32>;
@group(0) @binding(11) var<storage, read_write> jf: array<i32>;
@group(0) @binding(12) var<storage, read_write> bo: array<u32>;
@group(0) @binding(13) var<storage, read_write> outs: array<u32>;
@group(0) @binding(14) var<storage, read_write> expo: array<u32>;
@group(0) @binding(15) var<storage, read_write> tally: array<atomic<u32>>;
@group(0) @binding(16) var<storage, read> ctl: array<u32>;
@group(0) @binding(17) var<storage, read_write> bw: array<atomic<u32>>;
@group(0) @binding(18) var<storage, read_write> shdr: array<u32>;
@group(0) @binding(19) var<storage, read_write> stape: array<u32>;
@group(0) @binding(20) var<storage, read_write> births: array<u32>;
@group(0) @binding(21) var<storage, read_write> iargs: array<u32>;

const NONE: u32 = 0xFFFFFFFFu;
const C_NFLD: u32 = 0u;
const C_STREAM: u32 = 1u;
const C_MODE: u32 = 2u;
const C_ANYOUT: u32 = 3u;
const C_PHASE: u32 = 4u;
const C_F: u32 = 8u;
const CF_STRIDE: u32 = 10u;
const BIRTH_CAP: u32 = 16384u;

// ------------------------------------------------------------- arithmetic

fn mulhilo(a: u32, b: u32) -> vec2<u32> {
    let a0 = a & 0xFFFFu;
    let a1 = a >> 16u;
    let b0 = b & 0xFFFFu;
    let b1 = b >> 16u;
    let p00 = a0 * b0;
    let p01 = a0 * b1;
    let p10 = a1 * b0;
    let p11 = a1 * b1;
    let mid = (p00 >> 16u) + (p01 & 0xFFFFu) + (p10 & 0xFFFFu);
    let lo = (p00 & 0xFFFFu) | (mid << 16u);
    let hi = p11 + (p01 >> 16u) + (p10 >> 16u) + (mid >> 16u);
    return vec2<u32>(hi, lo);
}
fn add64(x: vec2<u32>, d: u32) -> vec2<u32> {
    let lo = x.y + d;
    var hi = x.x;
    if (lo < x.y) { hi = hi + 1u; }
    return vec2<u32>(hi, lo);
}
fn sub64(x: vec2<u32>, d: u32) -> vec2<u32> {
    var hi = x.x;
    if (x.y < d) { hi = hi - 1u; }
    return vec2<u32>(hi, x.y - d);
}
fn mulshr16(a: u32, b: u32) -> u32 {
    let x = mulhilo(a, b);
    return (x.x << 16u) | (x.y >> 16u);
}
fn mulshr16_sat(a: u32, b: u32) -> u32 {
    let x = mulhilo(a, b);
    if ((x.x >> 16u) != 0u) { return 0xFFFFFFFFu; }
    return (x.x << 16u) | (x.y >> 16u);
}
fn mulshr8_sat(a: u32, b: u32) -> u32 {
    let x = mulhilo(a, b);
    if ((x.x >> 8u) != 0u) { return 0xFFFFFFFFu; }
    return (x.x << 24u) | (x.y >> 8u);
}
fn mad_shr16(a: u32, b: u32, d: u32) -> u32 {
    let x = add64(mulhilo(a, b), d);
    return (x.x << 16u) | (x.y >> 16u);
}
fn mad_shr32(a: u32, b: u32, d: u32) -> u32 {
    return add64(mulhilo(a, b), d).x;
}
fn sat32_mul(a: u32, b: u32) -> u32 {
    let x = mulhilo(a, b);
    if (x.x != 0u) { return 0xFFFFFFFFu; }
    return x.y;
}
fn sat_add(a: u32, b: u32) -> u32 {
    let s = a + b;
    if (s < a) { return 0xFFFFFFFFu; }
    return s;
}
fn ratio16(a_in: u32, b_in: u32) -> u32 {
    var a = a_in;
    var b = b_in;
    if (b == 0u) { return 0u; }
    while (b >= 65536u) {
        a = a >> 1u;
        b = b >> 1u;
    }
    return (a << 16u) / b;
}
// floor((k*(qa-qb) + r) / 2^16) mod 2^32
fn flux_j(k: u32, qa: u32, qb: u32, r: u32) -> i32 {
    if (qa >= qb) {
        let x = add64(mulhilo(k, qa - qb), r);
        return bitcast<i32>((x.x << 16u) | (x.y >> 16u));
    }
    let x = mulhilo(k, qb - qa);
    if (x.x == 0u && x.y <= r) { return 0; }
    let y = add64(sub64(x, r), 65535u);
    return -bitcast<i32>((y.x << 16u) | (y.y >> 16u));
}
fn flux_lim(j: u32, q: u32, o: u32) -> u32 {
    if (o > q) { return mulshr16(j, ratio16(q, o)); }
    return j;
}
fn relax_t(t: u32, t_amb: u32, relax: u32, d: u32) -> u32 {
    let j = flux_j(relax, t_amb, t, d);
    if (j >= 0) { return sat_add(t, u32(j)); }
    let m = u32(-j);
    if (m > t) { return 0u; }
    return t - m;
}

// ------------------------------------------------------------- philox

fn philox(k0: u32, k1: u32, c: vec4<u32>) -> vec4<u32> {
    var x = c;
    var ka = k0;
    var kb = k1;
    for (var i = 0u; i < 10u; i = i + 1u) {
        let m0 = mulhilo(0xD2511F53u, x.x);
        let m1 = mulhilo(0xCD9E8D57u, x.z);
        x = vec4<u32>(m1.x ^ x.y ^ ka, m1.y, m0.x ^ x.w ^ kb, m0.y);
        ka = ka + 0x9E3779B9u;
        kb = kb + 0xBB67AE85u;
    }
    return x;
}
fn rng4(ph: u32, id: u32, stream: u32, draw: u32) -> vec4<u32> {
    return philox(Q[Q_SEED_LO], Q[Q_SEED_HI], vec4<u32>(id, Q[Q_EPOCH], (ph << 24u) | (stream & 0xFFFFFFu), draw));
}
fn rng(ph: u32, id: u32, stream: u32, draw: u32) -> u32 {
    return rng4(ph, id, stream, draw).x;
}

// ------------------------------------------------------------- state access

fn has(f: u32) -> bool { return (Q[Q_FLAGS] & f) != 0u; }
fn dims() -> u32 { return Q[Q_DIMS]; }
fn nf() -> u32 { return Q[Q_NF]; }
fn lmax() -> u32 { return Q[Q_LMAX]; }
fn mirrored() -> bool { return Q[Q_MIRRORED] != 0u; }
fn F(c: u32, i: u32) -> u32 { return fields[c * nf() + i]; }
fn setF(c: u32, i: u32, v: u32) { fields[c * nf() + i] = v; }
fn H(c: u32, w: u32) -> u32 { return hdr[c * HDR + w]; }
fn setH(c: u32, w: u32, v: u32) { hdr[c * HDR + w] = v; }
fn occ(c: u32) -> bool { return (hdr[c * HDR + H_FLAGS] & FL_OCC) != 0u; }
fn bonds(c: u32) -> u32 { return (hdr[c * HDR + H_FLAGS] & BOND_MASK) >> BOND_SHIFT; }
fn wall(c: u32) -> u32 { return site[c * SITE + S_WALL]; }
fn f_chem(k: u32, h: u32) -> u32 { return 2u + 2u * k + h; }
fn f_pool(cl: u32) -> u32 { return 2u + 2u * Q[Q_K] + cl; }
fn f_sig(j: u32, h: u32) -> u32 { return 2u + 2u * Q[Q_K] + 3u + 2u * j + h; }
fn nb_raw(c: u32, d: u32) -> u32 { return nbr[c * 6u + d]; }
fn nbw(c: u32, d: u32) -> u32 {
    if (dims() == 0u || d / 2u >= dims()) { return NONE; }
    let t = nbr[c * 6u + d];
    if (t == NONE) { return NONE; }
    if (wall(t) != 0u) { return NONE; }
    return t;
}
fn mirror_cell(c: u32) -> u32 {
    if (dims() == 0u) { return c; }
    let sx = Q[Q_SX];
    let x = c % sx;
    return (sx - 1u - x) + (c - x);
}
fn canon(c: u32) -> u32 {
    if (mirrored()) { return mirror_cell(c); }
    return c;
}
fn mirror_dir(d: u32) -> u32 {
    if (d < 2u) { return d ^ 1u; }
    return d;
}
fn arr(off: u32, t: u32) -> u32 { return TB[off + min(t >> 4u, 4095u)]; }
fn is_chiral(b: u32) -> bool { return b >= 0x20u && b <= 0x3Fu; }
fn mirror_b(b: u32) -> u32 { if (is_chiral(b)) { return b ^ 1u; } return b; }
fn class_of(b: u32) -> u32 {
    if (b == 0u) { return 3u; }
    if (is_chiral(b)) { return b & 1u; }
    return 2u;
}
fn tb(c: u32, i: u32) -> u32 {
    let a = c * lmax() + i;
    return (tapes[a >> 2u] >> ((a & 3u) * 8u)) & 0xFFu;
}
fn tset(c: u32, i: u32, v: u32) {
    let a = c * lmax() + i;
    let w = a >> 2u;
    let sh = (a & 3u) * 8u;
    tapes[w] = (tapes[w] & ~(0xFFu << sh)) | ((v & 0xFFu) << sh);
}
fn gidx(gid: vec3<u32>) -> u32 { return gid.x + gid.y * 65535u * 64u; }

// ------------------------------------------------------------- tallies

var<workgroup> wt: array<atomic<u32>, 64>;

fn wtally(s: u32, v: u32) {
    if (v == 0u) { return; }
    let o = atomicAdd(&wt[2u * s], v);
    if (o + v < o) { atomicAdd(&wt[2u * s + 1u], 1u); }
}
fn wflush(lid: u32) {
    workgroupBarrier();
    if (lid < NTALLY) {
        let lo = atomicLoad(&wt[2u * lid]);
        let hi = atomicLoad(&wt[2u * lid + 1u]);
        if (lo != 0u || hi != 0u) {
            let o = atomicAdd(&tally[2u * lid], lo);
            var carry = 0u;
            if (o + lo < o) { carry = 1u; }
            atomicAdd(&tally[2u * lid + 1u], hi + carry);
        }
    }
}

// ------------------------------------------------------------- phase 2

@compute @workgroup_size(64)
fn k_light(@builtin(global_invocation_id) gid: vec3<u32>) {
    let c = gidx(gid);
    if (c >= Q[Q_N]) { return; }
    var y = 0u;
    if (dims() >= 2u) { y = (c / Q[Q_SX]) % Q[Q_SY]; }
    light[c] = rows[y];
}

@compute @workgroup_size(64)
fn k_light3d(@builtin(global_invocation_id) gid: vec3<u32>) {
    let col = gidx(gid);
    let sx = Q[Q_SX];
    let sy = Q[Q_SY];
    let sz = Q[Q_SZ];
    if (col >= sx * sy) { return; }
    let x = col % sx;
    let y = col / sx;
    var i = rows[y];
    var z = sz;
    loop {
        if (z == 0u) { break; }
        z = z - 1u;
        let c = x + sx * (y + sy * z);
        light[c] = i;
        if (occ(c)) { i = mulshr16(i, Q[Q_SUN_ATT]); }
    }
}

fn sun_cell(c: u32) {
    let l = light[c];
    if (l == 0u) { return; }
    let d = rng(PH_SOURCES, canon(c), 0u, 0u) & 0xFFFFu;
    let add = (l >> 16u) + (((l & 0xFFFFu) + d) >> 16u);
    setF(c, 0u, sat_add(F(c, 0u), add));
    setF(c, 1u, sat_add(F(c, 1u), mulhilo(l, Q[Q_SUN_HEAT]).x));
    wtally(T_SUN, add);
}
@compute @workgroup_size(64)
fn k_sun(@builtin(global_invocation_id) gid: vec3<u32>, @builtin(local_invocation_index) lid: u32) {
    let c = gidx(gid);
    if (c < Q[Q_N]) { sun_cell(c); }
    wflush(lid);
}

@compute @workgroup_size(1)
fn k_vents() {
    let nv = vents[0];
    for (var i = 0u; i < nv; i = i + 1u) {
        let c = vents[1u + i];
        if (!has(G_CHEM_ONLY)) { setF(c, 0u, sat_add(F(c, 0u), Q[Q_VENT_RATE])); }
        setF(c, 1u, sat_add(F(c, 1u), Q[Q_VENT_HEAT]));
        let x4 = Q[Q_X4];
        if (x4 != NONE) {
            for (var h = 0u; h < 2u; h = h + 1u) {
                setF(c, f_chem(x4, h), F(c, f_chem(x4, h)) + Q[Q_VENT_X4]);
            }
        }
    }
}

// ------------------------------------------------------------- phase 3: flux

fn nfld() -> u32 { return ctl[C_NFLD]; }
fn cf(k: u32, w: u32) -> u32 { return ctl[C_F + k * CF_STRIDE + w]; }
// field descriptor words
const CF_OFF: u32 = 0u;
const CF_KAPPA: u32 = 1u;
const CF_GAMMA: u32 = 2u;
const CF_BONDED: u32 = 3u;
const CF_HASOUT: u32 = 4u;
const CF_OUT: u32 = 5u;
const CF_SLOT: u32 = 6u;
const CF_TSLOT: u32 = 7u;
const CF_TMULT: u32 = 8u;

fn qv(c: u32, k: u32) -> u32 {
    if (ctl[C_MODE] == 1u) { return hdr[c * HDR + H_E]; }
    return fields[c * nf() + cf(k, CF_OFF)];
}
fn setqv(c: u32, k: u32, v: u32) {
    if (ctl[C_MODE] == 1u) { hdr[c * HDR + H_E] = v; return; }
    fields[c * nf() + cf(k, CF_OFF)] = v;
}
fn dith(w: vec4<u32>, slot: u32) -> u32 {
    return (w[slot / 2u] >> (16u * (slot % 2u))) & 0xFFFFu;
}
fn ji(c: u32, a: u32, k: u32) -> u32 { return (c * 3u + a) * 8u + k; }

@compute @workgroup_size(64)
fn k_flux_a(@builtin(global_invocation_id) gid: vec3<u32>) {
    let c = gidx(gid);
    if (c >= Q[Q_N]) { return; }
    let n = nfld();
    let D = dims();
    for (var k = 0u; k < n; k = k + 1u) {
        for (var a = 0u; a < 3u; a = a + 1u) { jf[ji(c, a, k)] = 0; }
        bo[c * 8u + k] = 0u;
    }
    if (wall(c) != 0u) { return; }
    let ph = ctl[C_PHASE];
    let stream = ctl[C_STREAM];
    for (var a = 0u; a < D; a = a + 1u) {
        let t = nb_raw(c, 2u * a);
        if (t == NONE) { continue; }
        if (wall(t) != 0u) { continue; }
        let bonded = (bonds(c) & (1u << (2u * a))) != 0u;
        var id = canon(c) * 3u + a;
        var flip = false;
        if (mirrored() && a == 0u) {
            id = canon(t) * 3u;
            flip = true;
        }
        let w = rng4(ph, id, stream, 0u);
        for (var k = 0u; k < n; k = k + 1u) {
            let kappa = cf(k, CF_KAPPA);
            if (kappa == 0u || (cf(k, CF_BONDED) != 0u && !bonded)) { continue; }
            var kk = kappa;
            if (cf(k, CF_GAMMA) != 0u && bonded) { kk = mulshr16(kappa, cf(k, CF_GAMMA)); }
            var r = dith(w, cf(k, CF_SLOT));
            if (flip) { r = 0xFFFFu - r; }
            jf[ji(c, a, k)] = flux_j(kk, qv(c, k), qv(t, k), r);
        }
    }
    if (ctl[C_ANYOUT] != 0u) {
        for (var d = 0u; d < 2u * D; d = d + 1u) {
            let t = nb_raw(c, d);
            var absorbing = false;
            if (t == NONE) {
                absorbing = Q[Q_BOUND + d / 2u] == 2u;
            } else {
                absorbing = wall(t) == WALL_ABSORB;
            }
            if (!absorbing) { continue; }
            var cd = d;
            if (mirrored()) { cd = mirror_dir(d); }
            let w = rng4(ph, canon(c) * 8u + cd, stream | 0x8000u, 0u);
            for (var k = 0u; k < n; k = k + 1u) {
                if (cf(k, CF_HASOUT) != 0u) {
                    let x = flux_j(cf(k, CF_KAPPA), qv(c, k), cf(k, CF_OUT), dith(w, cf(k, CF_SLOT)));
                    if (x > 0) { bo[c * 8u + k] = bo[c * 8u + k] + u32(x); }
                }
            }
        }
    }
}

@compute @workgroup_size(64)
fn k_flux_b(@builtin(global_invocation_id) gid: vec3<u32>) {
    let c = gidx(gid);
    if (c >= Q[Q_N]) { return; }
    let n = nfld();
    let D = dims();
    for (var k = 0u; k < n; k = k + 1u) {
        var o = bo[c * 8u + k];
        for (var a = 0u; a < D; a = a + 1u) {
            let x = jf[ji(c, a, k)];
            if (x > 0) { o = sat_add(o, u32(x)); }
            let s = nb_raw(c, 2u * a + 1u);
            if (s != NONE) {
                let y = jf[ji(s, a, k)];
                if (y < 0) { o = sat_add(o, u32(-y)); }
            }
        }
        outs[c * 8u + k] = o;
    }
}

@compute @workgroup_size(64)
fn k_flux_c(@builtin(global_invocation_id) gid: vec3<u32>) {
    let c = gidx(gid);
    if (c >= Q[Q_N]) { return; }
    let n = nfld();
    let D = dims();
    for (var k = 0u; k < n; k = k + 1u) {
        let qc = qv(c, k);
        for (var a = 0u; a < D; a = a + 1u) {
            let x = jf[ji(c, a, k)];
            if (x > 0) {
                jf[ji(c, a, k)] = i32(flux_lim(u32(x), qc, outs[c * 8u + k]));
            } else if (x < 0) {
                let t = nb_raw(c, 2u * a);
                jf[ji(c, a, k)] = -i32(flux_lim(u32(-x), qv(t, k), outs[t * 8u + k]));
            }
        }
        bo[c * 8u + k] = flux_lim(bo[c * 8u + k], qc, outs[c * 8u + k]);
    }
}

fn flux_d_cell(c: u32) {
    let n = nfld();
    let D = dims();
    for (var k = 0u; k < n; k = k + 1u) {
        let b = bo[c * 8u + k];
        var q = qv(c, k) - b;
        for (var a = 0u; a < D; a = a + 1u) {
            q = q - u32(jf[ji(c, a, k)]);
            let s = nb_raw(c, 2u * a + 1u);
            if (s != NONE) { q = q + u32(jf[ji(s, a, k)]); }
        }
        setqv(c, k, q);
        let ts = cf(k, CF_TSLOT);
        if (ts != NONE) {
            let m = cf(k, CF_TMULT);
            for (var i = 0u; i < m; i = i + 1u) { wtally(ts, b); }
        }
    }
}
@compute @workgroup_size(64)
fn k_flux_d(@builtin(global_invocation_id) gid: vec3<u32>, @builtin(local_invocation_index) lid: u32) {
    let c = gidx(gid);
    if (c < Q[Q_N]) { flux_d_cell(c); }
    wflush(lid);
}

fn post_cell(c: u32) {
    let id = canon(c);
    let r = rng4(PH_TRANSPORT, id, 0x10000u, 0u);
    if (has(G_ENERGY) && Q[Q_DISS] > 0u) {
        let l = mad_shr16(F(c, 0u), Q[Q_DISS], r.x & 0xFFFFu);
        setF(c, 0u, F(c, 0u) - l);
        setF(c, 1u, sat_add(F(c, 1u), mulshr16(l, Q[Q_HEAT])));
        wtally(T_DISS, l);
    }
    if (Q[Q_RELAX] != 0u) {
        setF(c, 1u, relax_t(F(c, 1u), Q[Q_TAMB], Q[Q_RELAX], r.y & 0xFFFFu));
    }
    for (var j = 0u; j < Q[Q_S]; j = j + 1u) {
        for (var h = 0u; h < 2u; h = h + 1u) {
            let i = f_sig(j, h);
            var hc = h;
            if (mirrored()) { hc = 1u - h; }
            let w = rng(PH_TRANSPORT, id, 0x10100u + j * 2u + hc, 0u) & 0xFFFFu;
            let l = mad_shr16(F(c, i), Q[Q_SIG_DECAY], w);
            setF(c, i, F(c, i) - min(l, F(c, i)));
        }
    }
}
@compute @workgroup_size(64)
fn k_post(@builtin(global_invocation_id) gid: vec3<u32>, @builtin(local_invocation_index) lid: u32) {
    let c = gidx(gid);
    if (c < Q[Q_N]) { post_cell(c); }
    wflush(lid);
}

// ------------------------------------------------------------- phase 4

fn chem_hand(h: u32) -> u32 {
    if (mirrored()) { return 1u - h; }
    return h;
}

fn chem_cell(c: u32) {
    if (wall(c) != 0u) { return; }
    let id = canon(c);
    let temp = F(c, 1u);
    if (has(G_CHEM)) {
        for (var ri = 0u; ri < Q[Q_NRX]; ri = ri + 1u) {
            let rb = Q_RX + ri * RX_STRIDE;
            let r0 = Q[rb];
            let r1 = Q[rb + 1u];
            let p0 = Q[rb + 2u];
            let p1 = Q[rb + 3u];
            let energy = bitcast<i32>(Q[rb + 4u]);
            let photo = Q[rb + 7u] != 0u;
            var rate: u32;
            if (photo) {
                rate = mulshr16_sat(Q[rb + 8u], light[c] / Q[Q_I0I]);
            } else {
                rate = mulshr16_sat(Q[rb + 8u], arr(Q[rb + 9u], temp));
            }
            var ev = vec2<u32>(0u, 0u);
            for (var h = 0u; h < 2u; h = h + 1u) {
                let c0 = F(c, f_chem(r0, h));
                let d = rng(PH_CHEM, id, ri * 2u + chem_hand(h), 0u);
                var prod = c0;
                if (!photo && r1 != NONE) { prod = sat32_mul(c0, F(c, f_chem(r1, h))); }
                var cap = c0;
                if (r1 != NONE) {
                    if (r1 == r0) { cap = c0 / 2u; } else { cap = min(c0, F(c, f_chem(r1, h))); }
                }
                ev[h] = min(mad_shr32(rate, prod, d), cap);
            }
            if (energy < 0) {
                let e = u32(-energy);
                let s = mulhilo(ev.x + ev.y, e);
                var need = s.y;
                if (s.x != 0u) { need = 0xFFFFFFFFu; }
                var have = 0u;
                if (has(G_ENERGY)) { have = F(c, 0u); }
                if (need > have) {
                    let r = ratio16(have, need);
                    ev.x = mulshr16(ev.x, r);
                    ev.y = mulshr16(ev.y, r);
                }
                let used = (ev.x + ev.y) * e;
                setF(c, 0u, F(c, 0u) - used);
                wtally(T_RXN_USED, used);
            }
            for (var h = 0u; h < 2u; h = h + 1u) {
                let e = ev[h];
                if (e == 0u) { continue; }
                setF(c, f_chem(r0, h), F(c, f_chem(r0, h)) - e);
                if (r1 != NONE) { setF(c, f_chem(r1, h), F(c, f_chem(r1, h)) - e); }
                setF(c, f_chem(p0, h), F(c, f_chem(p0, h)) + e);
                if (p1 != NONE) { setF(c, f_chem(p1, h), F(c, f_chem(p1, h)) + e); }
                if (energy > 0) {
                    let heat = mulshr16(e, Q[rb + 5u + h]);
                    setF(c, 1u, sat_add(F(c, 1u), mulshr16(heat, Q[Q_RXN_HEAT])));
                }
            }
        }
        if (Q[Q_SINK] > 0u) {
            for (var k = 0u; k < Q[Q_K]; k = k + 1u) {
                for (var h = 0u; h < 2u; h = h + 1u) {
                    let i = f_chem(k, h);
                    let d = rng(PH_CHEM, id, 500u + k * 2u + chem_hand(h), 0u) & 0xFFFFu;
                    let l = mad_shr16(F(c, i), Q[Q_SINK], d);
                    setF(c, i, F(c, i) - l);
                    for (var m = 0u; m < Q[Q_MASS + k]; m = m + 1u) { wtally(T_ATOM_SINK, l); }
                }
            }
        }
    }
    if (Q[Q_RAC] > 0u) {
        let rate = mulshr16_sat(Q[Q_RAC], arr(Q[Q_ARR_RAC], temp));
        let r_ld = mulshr16(rate, Q[Q_RAC_BIAS]);
        if (has(G_CHEM)) {
            for (var k = 0u; k < Q[Q_K]; k = k + 1u) {
                let x = racem(c, id, 2u + 2u * k, 3u + 2u * k, k, rate, r_ld);
            }
        }
        if (has(G_MATTER)) {
            let x = racem(c, id, f_pool(0u), f_pool(1u), 100u, rate, r_ld);
            wtally(T_RAC_SINK, x.x);
            wtally(T_RAC_SRC + 1u, x.x);
            wtally(T_RAC_SINK + 1u, x.y);
            wtally(T_RAC_SRC, x.y);
        }
    }
}
fn racem(c: u32, id: u32, li: u32, di: u32, sid: u32, rate: u32, r_ld: u32) -> vec2<u32> {
    let cl = F(c, li);
    let cd = F(c, di);
    let dl = rng(PH_CHEM, id, 1000u + sid * 2u + chem_hand(0u), 0u);
    let dd = rng(PH_CHEM, id, 1000u + sid * 2u + chem_hand(1u), 0u);
    let n_ld = min(mad_shr32(r_ld, cl, dl), cl);
    let n_dl = min(mad_shr32(rate, cd, dd), cd);
    setF(c, li, cl - n_ld + n_dl);
    setF(c, di, cd - n_dl + n_ld);
    return vec2<u32>(n_ld, n_dl);
}
@compute @workgroup_size(64)
fn k_chem(@builtin(global_invocation_id) gid: vec3<u32>, @builtin(local_invocation_index) lid: u32) {
    let c = gidx(gid);
    if (c < Q[Q_N]) { chem_cell(c); }
    wflush(lid);
}

// ------------------------------------------------------------- phase 5

@compute @workgroup_size(64)
fn k_flagclear(@builtin(global_invocation_id) gid: vec3<u32>) {
    let c = gidx(gid);
    if (c >= Q[Q_N]) { return; }
    let i = c * HDR + H_FLAGS;
    hdr[i] = hdr[i] & ~(FL_EXEC | FL_NEWBORN);
    if (!has(G_ENERGY) && H(c, H_SLEEP) > 0u) { setH(c, H_SLEEP, H(c, H_SLEEP) - 1u); }
}

@compute @workgroup_size(64)
fn k_expo(@builtin(global_invocation_id) gid: vec3<u32>) {
    let c = gidx(gid);
    if (c >= Q[Q_N]) { return; }
    let faces = 2u * dims();
    if (faces == 0u || !occ(c)) {
        expo[c] = 65536u;
        return;
    }
    let bm = bonds(c);
    var b = 0u;
    var o = 0u;
    for (var d = 0u; d < faces; d = d + 1u) {
        if ((bm & (1u << d)) != 0u) {
            b = b + 1u;
        } else {
            let t = nb_raw(c, d);
            if (t != NONE) {
                if (wall(t) == 0u && occ(t)) { o = o + 1u; }
            }
        }
    }
    let cov = (b * 65536u + Q[Q_W_OCC] * o) / faces;
    if (cov >= 65536u) { expo[c] = 0u; } else { expo[c] = 65536u - cov; }
}

fn absorb_cell(c: u32) {
    if (!occ(c)) { return; }
    let a = mulshr16(Q[Q_ABSORB], expo[c]);
    let de = mulshr16(a, F(c, 0u));
    setF(c, 0u, F(c, 0u) - de);
    setH(c, H_E, sat_add(H(c, H_E), de));
    let d = rng(PH_ABSORB, canon(c), 0u, 0u) & 0xFFFFu;
    var up = Q[Q_UPK_BASE] + Q[Q_UPK_BYTE] * H(c, H_LEN);
    if (H(c, H_SLEEP) > 0u) {
        up = up / 8u;
        setH(c, H_SLEEP, H(c, H_SLEEP) - 1u);
    }
    let upk = (up + d) >> 16u;
    let paid = min(upk, H(c, H_E));
    setH(c, H_E, H(c, H_E) - paid);
    setF(c, 1u, sat_add(F(c, 1u), mulshr16(paid, Q[Q_HEAT])));
    wtally(T_UPKEEP, paid);
}
@compute @workgroup_size(64)
fn k_absorb(@builtin(global_invocation_id) gid: vec3<u32>, @builtin(local_invocation_index) lid: u32) {
    let c = gidx(gid);
    if (c < Q[Q_N]) { absorb_cell(c); }
    wflush(lid);
}

@compute @workgroup_size(64)
fn k_wake(@builtin(global_invocation_id) gid: vec3<u32>) {
    let c = gidx(gid);
    if (c >= Q[Q_N] || !occ(c)) { return; }
    let i = c * HDR + H_FLAGS;
    if (H(c, H_E) == 0u) {
        hdr[i] = hdr[i] | FL_HALT;
    } else if ((hdr[i] & FL_HALT) != 0u && H(c, H_E) >= Q[Q_WAKE]) {
        hdr[i] = hdr[i] & ~FL_HALT;
    }
}

// ------------------------------------------------------------- after exec

fn site_cell(c: u32) {
    let sp = site[c * SITE + S_SPENT];
    let rx = site[c * SITE + S_RXN];
    wtally(T_SPENT, sp);
    wtally(T_RXN_GAIN, rx);
    site[c * SITE + S_SPENT] = 0u;
    site[c * SITE + S_RXN] = 0u;
    if (site[c * SITE + S_VOTE] != 0u) { wtally(T_VOTES, 1u); }
    if ((H(c, H_FLAGS) & FL_NEWBORN) != 0u) {
        wtally(T_BIRTHS, 1u);
        var h = 0x811c9dc5u;
        for (var i = 0u; i < H(c, H_LEN); i = i + 1u) {
            h = (h ^ tb(c, i)) * 0x01000193u;
        }
        let slot = atomicAdd(&tally[2u * T_BIRTH_COUNT], 1u);
        if (slot < BIRTH_CAP) {
            let b = slot * 6u;
            births[b] = Q[Q_EPOCH];
            births[b + 1u] = H(c, H_PARENT);
            births[b + 2u] = H(c, H_LINEAGE);
            births[b + 3u] = c;
            births[b + 4u] = H(c, H_DEPTH);
            births[b + 5u] = h;
        }
    }
}
@compute @workgroup_size(64)
fn k_site(@builtin(global_invocation_id) gid: vec3<u32>, @builtin(local_invocation_index) lid: u32) {
    let c = gidx(gid);
    if (c < Q[Q_N]) { site_cell(c); }
    wflush(lid);
}

// ------------------------------------------------------------- phase 7: bodies
// bw layout: [0,n) label, [n,2n) size, [2n,8n) votes, [8n,9n) cand,
// [9n,10n) fail, [10n,11n) claims, [11n,12n) received

fn B_LAB() -> u32 { return 0u; }
fn B_SIZE() -> u32 { return Q[Q_N]; }
fn B_VOTES() -> u32 { return 2u * Q[Q_N]; }
fn B_CAND() -> u32 { return 8u * Q[Q_N]; }
fn B_FAIL() -> u32 { return 9u * Q[Q_N]; }
fn B_CLAIM() -> u32 { return 10u * Q[Q_N]; }
fn B_RECV() -> u32 { return 11u * Q[Q_N]; }
fn cellof(id: u32) -> u32 {
    if (mirrored()) { return mirror_cell(id); }
    return id;
}
fn lab(c: u32) -> u32 { return atomicLoad(&bw[B_LAB() + c]); }

@compute @workgroup_size(64)
fn k_lab_init(@builtin(global_invocation_id) gid: vec3<u32>) {
    let c = gidx(gid);
    if (c >= Q[Q_N]) { return; }
    var l = NONE;
    if (bonds(c) != 0u) { l = canon(c); }
    atomicStore(&bw[B_LAB() + c], l);
}

// Union-find style labelling: hook trees onto smaller labels, then
// shortcut. Labels only decrease and stay inside the component, so the
// fixed point is the component's minimum canonical index whatever the
// thread order. Rounds are gated on the GPU (indirect dispatch), so no
// read-back is needed.
fn set_changed() { atomicStore(&tally[2u * T_CHANGED], 1u); }

@compute @workgroup_size(64)
fn k_lab_hook(@builtin(global_invocation_id) gid: vec3<u32>) {
    let c = gidx(gid);
    if (c >= Q[Q_N]) { return; }
    let lc = lab(c);
    if (lc == NONE) { return; }
    let bm = bonds(c);
    for (var d = 0u; d < 6u; d = d + 1u) {
        if ((bm & (1u << d)) == 0u) { continue; }
        let t = nb_raw(c, d);
        if (t == NONE) { continue; }
        let lt = lab(t);
        if (lt < lc) {
            let o1 = atomicMin(&bw[B_LAB() + cellof(lc)], lt);
            let o2 = atomicMin(&bw[B_LAB() + c], lt);
            if (o1 > lt || o2 > lt) { set_changed(); }
        }
    }
}

// One round: hook onto smaller neighbour labels, then shortcut twice.
@compute @workgroup_size(64)
fn k_lab_round(@builtin(global_invocation_id) gid: vec3<u32>) {
    let c = gidx(gid);
    if (c >= Q[Q_N]) { return; }
    var lc = lab(c);
    if (lc == NONE) { return; }
    let bm = bonds(c);
    var changed = false;
    for (var d = 0u; d < 6u; d = d + 1u) {
        if ((bm & (1u << d)) == 0u) { continue; }
        let t = nb_raw(c, d);
        if (t == NONE) { continue; }
        let lt = lab(t);
        if (lt < lc) {
            let o1 = atomicMin(&bw[B_LAB() + cellof(lc)], lt);
            let o2 = atomicMin(&bw[B_LAB() + c], lt);
            if (o1 > lt || o2 > lt) { changed = true; }
            lc = min(lc, lt);
        }
    }
    for (var k = 0u; k < 2u; k = k + 1u) {
        let l = lab(c);
        let r = lab(cellof(l));
        if (r < l) {
            atomicMin(&bw[B_LAB() + c], r);
            changed = true;
        }
    }
    if (changed) { set_changed(); }
}

@compute @workgroup_size(64)
fn k_lab_jump(@builtin(global_invocation_id) gid: vec3<u32>) {
    let c = gidx(gid);
    if (c >= Q[Q_N]) { return; }
    let l = lab(c);
    if (l == NONE) { return; }
    let r = lab(cellof(l));
    if (r < l) {
        atomicMin(&bw[B_LAB() + c], r);
        set_changed();
    }
}

fn set_groups(at: u32, on: bool) {
    let g = (Q[Q_N] + 63u) / 64u;
    if (!on) {
        iargs[at] = 0u;
        iargs[at + 1u] = 1u;
        iargs[at + 2u] = 1u;
    } else if (g > 65535u) {
        iargs[at] = 65535u;
        iargs[at + 1u] = (g + 65534u) / 65535u;
        iargs[at + 2u] = 1u;
    } else {
        iargs[at] = g;
        iargs[at + 1u] = 1u;
        iargs[at + 2u] = 1u;
    }
}

// iargs: [0..3) labelling rounds, [3..6) body phase
@compute @workgroup_size(1)
fn k_body_gate() {
    let on = atomicLoad(&tally[2u * T_VOTES]) > 0u;
    set_groups(0u, on);
    set_groups(3u, on);
    atomicStore(&tally[2u * T_CHANGED], 0u);
}

@compute @workgroup_size(1)
fn k_lab_gate() {
    let more = atomicLoad(&tally[2u * T_CHANGED]) != 0u;
    if (!more) { set_groups(0u, false); } else { atomicAdd(&tally[2u * T_ROUNDS], 1u); }
    atomicStore(&tally[2u * T_CHANGED], 0u);
}

// After the last round: any edge with unequal labels means the labelling did
// not converge; count it (it must stay 0) and skip the body phase.
@compute @workgroup_size(64)
fn k_lab_verify(@builtin(global_invocation_id) gid: vec3<u32>) {
    let c = gidx(gid);
    if (c >= Q[Q_N]) { return; }
    let lc = lab(c);
    if (lc == NONE) { return; }
    var bad = lab(cellof(lc)) != lc;
    let bm = bonds(c);
    for (var d = 0u; d < 6u; d = d + 1u) {
        if ((bm & (1u << d)) != 0u) {
            let t = nb_raw(c, d);
            if (t != NONE && lab(t) != lc) { bad = true; }
        }
    }
    if (bad) {
        atomicAdd(&tally[2u * T_FAULT], 1u);
    }
}

@compute @workgroup_size(1)
fn k_fault_gate() {
    if (atomicLoad(&tally[2u * T_FAULT]) != 0u) { set_groups(3u, false); }
}

@compute @workgroup_size(64)
fn k_body_tally(@builtin(global_invocation_id) gid: vec3<u32>) {
    let c = gidx(gid);
    if (c >= Q[Q_N]) { return; }
    let l = lab(c);
    if (l == NONE) { return; }
    let root = cellof(l);
    atomicAdd(&bw[B_SIZE() + root], 1u);
    let v = site[c * SITE + S_VOTE];
    if (v != 0u) { atomicAdd(&bw[B_VOTES() + root * 6u + v - 1u], 1u); }
}

fn ge64(a: vec2<u32>, b: vec2<u32>) -> bool {
    if (a.x != b.x) { return a.x > b.x; }
    return a.y >= b.y;
}

@compute @workgroup_size(64)
fn k_body_decide(@builtin(global_invocation_id) gid: vec3<u32>) {
    let c = gidx(gid);
    if (c >= Q[Q_N]) { return; }
    atomicStore(&bw[B_CAND() + c], 0u);
    let l = lab(c);
    if (l == NONE || cellof(l) != c) { return; }
    let size = atomicLoad(&bw[B_SIZE() + c]);
    if (size > Q[Q_MAX_BODY]) { return; }
    var best = 0u;
    var bv = 0u;
    for (var d = 0u; d < 6u; d = d + 1u) {
        let v = atomicLoad(&bw[B_VOTES() + c * 6u + d]);
        if (v > bv) {
            bv = v;
            best = d;
        }
    }
    if (bv == 0u) { return; }
    for (var d = 0u; d < 6u; d = d + 1u) {
        if (d != best && atomicLoad(&bw[B_VOTES() + c * 6u + d]) >= bv) { return; }
    }
    // (bv << 16) >= vote_q16 * size
    if (!ge64(vec2<u32>(bv >> 16u, bv << 16u), mulhilo(Q[Q_VOTE_Q16], size))) { return; }
    atomicStore(&bw[B_CAND() + c], best + 1u);
}

fn member_dir(c: u32) -> u32 {
    let l = lab(c);
    if (l == NONE) { return NONE; }
    let root = cellof(l);
    let cd = atomicLoad(&bw[B_CAND() + root]);
    if (cd == 0u) { return NONE; }
    return cd - 1u;
}

@compute @workgroup_size(64)
fn k_body_check(@builtin(global_invocation_id) gid: vec3<u32>) {
    let c = gidx(gid);
    if (c >= Q[Q_N]) { return; }
    let d = member_dir(c);
    if (d == NONE) { return; }
    let root = cellof(lab(c));
    let t = nbw(c, d);
    var ok = t != NONE;
    if (ok) { ok = !occ(t) || lab(t) == lab(c); }
    if (!ok) { atomicStore(&bw[B_FAIL() + root], 1u); }
}

@compute @workgroup_size(64)
fn k_body_claim(@builtin(global_invocation_id) gid: vec3<u32>) {
    let c = gidx(gid);
    if (c >= Q[Q_N]) { return; }
    let d = member_dir(c);
    if (d == NONE) { return; }
    let root = cellof(lab(c));
    if (atomicLoad(&bw[B_FAIL() + root]) != 0u) { return; }
    atomicAdd(&bw[B_CLAIM() + nbw(c, d)], 1u);
}

@compute @workgroup_size(64)
fn k_body_check2(@builtin(global_invocation_id) gid: vec3<u32>) {
    let c = gidx(gid);
    if (c >= Q[Q_N]) { return; }
    let d = member_dir(c);
    if (d == NONE) { return; }
    let root = cellof(lab(c));
    if (atomicLoad(&bw[B_FAIL() + root]) != 0u) { return; }
    if (atomicLoad(&bw[B_CLAIM() + nbw(c, d)]) > 1u) { atomicStore(&bw[B_FAIL() + root], 2u); }
}

fn moving_dir(c: u32) -> u32 {
    let d = member_dir(c);
    if (d == NONE) { return NONE; }
    if (atomicLoad(&bw[B_FAIL() + cellof(lab(c))]) != 0u) { return NONE; }
    return d;
}

@compute @workgroup_size(64)
fn k_body_move1(@builtin(global_invocation_id) gid: vec3<u32>, @builtin(local_invocation_index) lid: u32) {
    let c = gidx(gid);
    if (c < Q[Q_N]) {
        let d = moving_dir(c);
        if (d != NONE) {
            let t = nbw(c, d);
            for (var w = 0u; w < HDR; w = w + 1u) { shdr[t * HDR + w] = hdr[c * HDR + w]; }
            let nw = lmax() / 4u;
            for (var i = 0u; i < nw; i = i + 1u) { stape[t * nw + i] = tapes[c * nw + i]; }
            atomicStore(&bw[B_RECV() + t], 1u);
            if (cellof(lab(c)) == c) { wtally(T_BODY_MOVES, 1u); }
        }
    }
    wflush(lid);
}

@compute @workgroup_size(64)
fn k_body_move2(@builtin(global_invocation_id) gid: vec3<u32>) {
    let c = gidx(gid);
    if (c >= Q[Q_N]) { return; }
    let d = moving_dir(c);
    if (d != NONE && atomicLoad(&bw[B_RECV() + c]) == 0u) {
        for (var w = 0u; w < HDR; w = w + 1u) { hdr[c * HDR + w] = 0u; }
        let nw = lmax() / 4u;
        for (var i = 0u; i < nw; i = i + 1u) { tapes[c * nw + i] = 0u; }
    }
}

@compute @workgroup_size(64)
fn k_body_move3(@builtin(global_invocation_id) gid: vec3<u32>) {
    let c = gidx(gid);
    if (c >= Q[Q_N]) { return; }
    if (atomicLoad(&bw[B_RECV() + c]) != 0u) {
        for (var w = 0u; w < HDR; w = w + 1u) { hdr[c * HDR + w] = shdr[c * HDR + w]; }
        let nw = lmax() / 4u;
        for (var i = 0u; i < nw; i = i + 1u) { tapes[c * nw + i] = stape[c * nw + i]; }
    }
}

@compute @workgroup_size(64)
fn k_clear_votes(@builtin(global_invocation_id) gid: vec3<u32>) {
    let c = gidx(gid);
    if (c >= Q[Q_N]) { return; }
    site[c * SITE + S_VOTE] = 0u;
}

// ------------------------------------------------------------- phase 8

var<private> mdraw: u32;
var<private> mid: u32;
fn mrnd() -> u32 {
    let r = rng(PH_MUTATE, mid, 0u, mdraw);
    mdraw = mdraw + 1u;
    return r;
}
fn poisson24(lam: u32, u: u32, kmax: u32) -> u32 {
    if (lam == 0u) { return 0u; }
    var p: u32;
    if (lam < (1u << 20u)) {
        let l = lam << 8u;
        let l2 = mulhilo(l, l).x;
        let l3 = mulhilo(l2, l).x;
        p = 0xFFFFFFFFu - l + l2 / 2u - l3 / 6u;
    } else {
        p = TB[Q[Q_POIS_OFF] + min(lam >> 14u, 65535u)];
    }
    var cdf = p;
    var k = 0u;
    loop {
        if (!(u >= cdf && k < kmax)) { break; }
        k = k + 1u;
        let x = mulhilo(p, lam);
        p = ((x.x << 8u) | (x.y >> 24u)) / k;
        if (p == 0u) { break; }
        cdf = sat_add(cdf, p);
    }
    return k;
}
fn elig(ch: u32, b: u32) -> bool {
    if (ch == 2u) { return is_chiral(b); }
    return b != 0u;
}
fn flip_frame(v: u32, bit: u32) -> u32 {
    if (mirrored()) { return mirror_b(mirror_b(v) ^ (1u << bit)); }
    return (v ^ (1u << bit)) & 0xFFu;
}

fn mutate_cell(c: u32) {
    if (!occ(c)) { return; }
    let len = H(c, H_LEN);
    var n_ne = 0u;
    var n_ch = 0u;
    for (var i = 0u; i < len; i = i + 1u) {
        let b = tb(c, i);
        if (b != 0u) { n_ne = n_ne + 1u; }
        if (is_chiral(b)) { n_ch = n_ch + 1u; }
    }
    let temp = F(c, 1u);
    mid = canon(c);
    mdraw = 0u;
    let e = expo[c];
    let irel = light[c] / Q[Q_I0I];
    var mx = 65536u;
    if (Q[Q_HAS_MAP] != 0u) { mx = mmap[c]; }
    let a_mut = arr(Q[Q_ARR_MUT], temp);
    let a_rac = arr(Q[Q_ARR_RAC], temp);
    let a_dec = arr(Q[Q_ARR_DEC], temp);
    let bg = mulshr16_sat(mulshr16_sat(Q[Q_MU_BG], a_mut), mx);
    let uv = mulshr16_sat(mulshr16(Q[Q_MU_UV], e), irel);
    let fl = mulshr16_sat(Q[Q_MU_FLIP], a_rac);
    let lf = sat_add(65536u, mulshr16_sat(mulshr16(Q[Q_DECAY_LIGHT], e), irel));
    let dc = mulshr16_sat(mulshr16_sat(Q[Q_DECAY], a_dec), lf);
    var lam = vec4<u32>(mulshr8_sat(bg, n_ne), mulshr8_sat(uv, n_ne), mulshr8_sat(fl, n_ch), mulshr8_sat(dc, n_ne));
    let matter = has(G_MATTER);
    let pb = 2u + 2u * Q[Q_K];
    for (var ch = 0u; ch < 4u; ch = ch + 1u) {
        let l = lam[ch];
        if (l == 0u) { continue; }
        let k = poisson24(l, mrnd(), 64u);
        for (var ev = 0u; ev < k; ev = ev + 1u) {
            var ne = 0u;
            for (var i = 0u; i < len; i = i + 1u) {
                if (elig(ch, tb(c, i))) { ne = ne + 1u; }
            }
            if (ne == 0u) { break; }
            let j = mrnd() % ne;
            var pos = 0u;
            var seen = 0u;
            for (var i = 0u; i < len; i = i + 1u) {
                if (elig(ch, tb(c, i))) {
                    if (seen == j) {
                        pos = i;
                        break;
                    }
                    seen = seen + 1u;
                }
            }
            let old = tb(c, pos);
            var nw = 0u;
            if (ch <= 1u) {
                nw = flip_frame(old, mrnd() % 8u);
            } else if (ch == 2u) {
                nw = mirror_b(old);
            }
            if (matter) {
                let co = class_of(old);
                let cn = class_of(nw);
                if (co < 3u) { setF(c, pb + co, F(c, pb + co) + 1u); }
                if (cn < 3u) {
                    if (F(c, pb + cn) == 0u) {
                        if (co < 3u) { setF(c, pb + co, F(c, pb + co) - 1u); }
                        continue;
                    }
                    setF(c, pb + cn, F(c, pb + cn) - 1u);
                }
            }
            tset(c, pos, nw);
        }
    }
    var allzero = true;
    for (var i = 0u; i < len; i = i + 1u) {
        if (tb(c, i) != 0u) {
            allzero = false;
            break;
        }
    }
    let starving = Q[Q_STARVE] > 0u && (H(c, H_FLAGS) & FL_HALT) != 0u;
    if (starving || allzero) { setH(c, H_ZERO, H(c, H_ZERO) + 1u); } else { setH(c, H_ZERO, 0u); }
}
@compute @workgroup_size(64)
fn k_mutate(@builtin(global_invocation_id) gid: vec3<u32>) {
    let c = gidx(gid);
    if (c < Q[Q_N]) { mutate_cell(c); }
}

@compute @workgroup_size(64)
fn k_bondbreak(@builtin(global_invocation_id) gid: vec3<u32>) {
    let c = gidx(gid);
    if (c >= Q[Q_N]) { return; }
    let bm = bonds(c);
    if (bm == 0u) { return; }
    var clear = 0u;
    for (var d = 0u; d < 2u * dims(); d = d + 1u) {
        if ((bm & (1u << d)) == 0u) { continue; }
        let t = nb_raw(c, d);
        let a = d / 2u;
        // the face is owned by its lower cell (the one whose +a neighbour is the other)
        var lo = c;
        var hi = t;
        if ((d & 1u) == 1u) {
            lo = t;
            hi = c;
        }
        var id = canon(lo) * 3u + a;
        if (mirrored() && a == 0u) { id = canon(hi) * 3u; }
        let tm = F(lo, 1u) / 2u + F(hi, 1u) / 2u;
        let pr = mulshr16_sat(Q[Q_BOND_BREAK], arr(Q[Q_ARR_BOND], tm));
        if (rng(PH_BONDBREAK, id, 0u, 0u) < pr) { clear = clear | (1u << d); }
    }
    let i = c * HDR + H_FLAGS;
    hdr[i] = hdr[i] & ~(clear << BOND_SHIFT);
}

fn dead_cell(c: u32) {
    if (!occ(c)) { return; }
    let len = H(c, H_LEN);
    var allzero = true;
    for (var i = 0u; i < len; i = i + 1u) {
        if (tb(c, i) != 0u) {
            allzero = false;
            break;
        }
    }
    let z = H(c, H_ZERO);
    if (allzero) {
        if (z < Q[Q_DEAD_AFTER]) { return; }
    } else if (Q[Q_STARVE] == 0u || z < Q[Q_STARVE]) {
        return;
    }
    let pb = 2u + 2u * Q[Q_K];
    for (var i = 0u; i < len; i = i + 1u) {
        let b = tb(c, i);
        if (has(G_MATTER)) {
            let cl = class_of(b);
            if (cl < 3u) { setF(c, pb + cl, F(c, pb + cl) + 1u); }
        }
    }
    let nw = lmax() / 4u;
    for (var i = 0u; i < nw; i = i + 1u) { tapes[c * nw + i] = 0u; }
    setF(c, 0u, sat_add(F(c, 0u), H(c, H_E)));
    for (var w = 0u; w < HDR; w = w + 1u) { hdr[c * HDR + w] = 0u; }
    wtally(T_DEATHS, 1u);
}
@compute @workgroup_size(64)
fn k_dead(@builtin(global_invocation_id) gid: vec3<u32>, @builtin(local_invocation_index) lid: u32) {
    let c = gidx(gid);
    if (c < Q[Q_N]) { dead_cell(c); }
    wflush(lid);
}

// cut bonds that now point at empty cells (the cells that just died)
@compute @workgroup_size(64)
fn k_dead_bonds(@builtin(global_invocation_id) gid: vec3<u32>) {
    let c = gidx(gid);
    if (c >= Q[Q_N]) { return; }
    let bm = bonds(c);
    if (bm == 0u) { return; }
    var clear = 0u;
    for (var d = 0u; d < 6u; d = d + 1u) {
        if ((bm & (1u << d)) != 0u) {
            let t = nb_raw(c, d);
            if (t != NONE) {
                if (!occ(t)) { clear = clear | (1u << d); }
            }
        }
    }
    let i = c * HDR + H_FLAGS;
    hdr[i] = hdr[i] & ~(clear << BOND_SHIFT);
}

// ------------------------------------------------------------- phase 9

fn ledger_cell(c: u32) {
    wtally(T_L_ENERGY, H(c, H_E));
    wtally(T_L_ENERGY, F(c, 0u));
    if (has(G_MATTER)) {
        for (var cl = 0u; cl < 3u; cl = cl + 1u) { wtally(T_L_MATTER + cl, F(c, f_pool(cl))); }
        var cnt = vec3<u32>(0u, 0u, 0u);
        for (var i = 0u; i < H(c, H_LEN); i = i + 1u) {
            let k = class_of(tb(c, i));
            if (k < 3u) { cnt[k] = cnt[k] + 1u; }
        }
        for (var cl = 0u; cl < 3u; cl = cl + 1u) { wtally(T_L_MATTER + cl, cnt[cl]); }
    }
    if (has(G_CHEM)) {
        var a = 0u;
        for (var k = 0u; k < Q[Q_K]; k = k + 1u) {
            a = a + Q[Q_MASS + k] * (F(c, f_chem(k, 0u)) + F(c, f_chem(k, 1u)));
        }
        wtally(T_L_ATOMS, a);
    }
}
@compute @workgroup_size(64)
fn k_ledger(@builtin(global_invocation_id) gid: vec3<u32>, @builtin(local_invocation_index) lid: u32) {
    let c = gidx(gid);
    if (c < Q[Q_N]) { ledger_cell(c); }
    wflush(lid);
}
